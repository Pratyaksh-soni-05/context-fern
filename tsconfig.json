  // its .d.ts output). package.json's "typecheck" script checks it
  // separately via `tsc -p packages/ui/tsconfig.json` — the same
  // pattern already used for tsconfig.tests.json/tsconfig.bench.json.
  // See docs/decisions.md.
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/store" },
    { "path": "packages/embed" },
    { "path": "packages/daemon" },
    { "path": "packages/cli" },
    { "path": "packages/plugin-claude-code" }
  ]
}

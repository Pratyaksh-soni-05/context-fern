{
  "name": "context-fern",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check . && uv run --project bench ruff check",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "bun test packages && uv run --project bench pytest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
